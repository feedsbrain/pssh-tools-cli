{
  "name": "@feedsbrain/pssh-tools-cli",
  "version": "1.1.0",
  "description": "Command Line Interface for PSSH-TOOLS",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "eslint . && npm run typecheck",
    "test": "node --test",
    "build": "eslint . && tsc -p .",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "prepare": "npm run build",
    "preversion": "npm run build",
    "prepublishOnly": "npm run build",
    "postpublish": "git push --follow-tags",
    "release": "npm version patch -m \"chore(release): %s\" && npm publish",
    "release:minor": "npm version minor -m \"chore(release): %s\" && npm publish",
    "release:major": "npm version major -m \"chore(release): %s\" && npm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedsbrain/pssh-tools-cli.git"
  },
  "keywords": [
    "pssh",
    "pssh-tools",
    "cli",
    "pssh-box",
    "drm",
    "widevine",
    "cenc",
    "playready",
    "marlin"
  ],
  "author": "Indra Gunawan <feedsbrain@gmail.com>",
  "license": "ISC",
  "bin": {
    "psshtools": "build/index.js"
  },
  "bugs": {
    "url": "https://github.com/feedsbrain/pssh-tools-cli/issues"
  },
  "homepage": "https://github.com/feedsbrain/pssh-tools-cli#readme",
  "dependencies": {
    "@feedsbrain/pssh-tools": "^1.2.3",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "neostandard": "0.14.0-next.1",
    "typescript": "^6.0.3"
  }
}
